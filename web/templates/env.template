# === Muse Relay client config ===
# Tệp mẫu .env — khi đóng zip được đổi tên thành .env.
# Các dòng có chú thích "wizard điền sẵn" được wizard của web UI thay
# giá trị khi tạo Muse. MUSE_EMAIL và MUSE_PASSWORD giữ TRỐNG.

# Địa chỉ project Supabase (wizard điền sẵn)
SUPABASE_URL=

# Anon key của Supabase (wizard điền sẵn)
SUPABASE_ANON_KEY=

# TRỐNG → Muse mở form cho owner điền (không in giá trị ra chat)
MUSE_EMAIL=

# TRỐNG → Muse mở form cho owner điền (không in giá trị ra chat)
MUSE_PASSWORD=

# Wizard điền theo tag của Muse: chat,image,video
CAPABILITIES=chat

# Chu kỳ poll tính bằng giây, tối thiểu 2 — cấm đặt nhỏ hơn 2
POLL_INTERVAL=3
