# Muse Relay — copy this file to .env and fill in your values
SUPABASE_PROJECT_ID=abcdefghijklmnopqrst
SUPABASE_SECRET_KEY=sb_secret_...or legacy JWT eyJ...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # public key (Dashboard → Settings → API)

# Local server
PORT=8080                  # web UI port (any free port you like)
WEB_UI_PASSWORD=change-me  # login password for the web UI — REQUIRED
API_KEY=mr_change-me       # Bearer key for the REST API /api/v1 — optional
