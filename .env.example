# ============================================================
# Muse Relay — biến môi trường (BẢN MẪU)
# Copy thành .env rồi điền giá trị thật:
#   cp .env.example .env
# .env đã bị git-ignore — KHÔNG bao giờ commit giá trị thật.
# Quy ước chung: quay vòng (rotate) định kỳ; giá trị chỉ in ra
# khi tuyệt đối cần, không dán vào chat/log/tài liệu.
# ============================================================

# ------------------------------------------------------------
# SUPABASE — nền tảng relay (Dashboard → Project Settings → API)
# ------------------------------------------------------------

# Project URL, dạng https://<project-ref>.supabase.co
# Dùng bởi: deploy script, suite test, dashboard (phan URL nhúng thẳng).
SUPABASE_URL=

# Publishable key — khóa CÔNG KHAI, an toàn để nhúng vào dashboard/client.
# Không phải bí mật; bảo mật thực sự nằm ở RLS + JWT + relay token.
SUPABASE_PUBLISHABLE_KEY=

# Secret key (service role) — BÍ MẬT TUYỆT ĐỐI, chỉ dùng phía "server":
# suite test (đọc/xoá hàng qua service role), admin auth API, Management API.
# Lộ key này = toàn quyền dự án. Rotate ngay nếu nghi ngờ lộ.
SUPABASE_SECRET_KEY=

# Access token cá nhân (Dashboard → Account → Access Tokens, dạng sbp_...)
# Chỉ dùng cho CLI/Management API: deploy Edge Functions, chạy migration.
# Đây là credential DUY NHẤT em cần anh cấp tay trong toàn bộ hệ thống.
SUPABASE_ACCESS_TOKEN=

# ------------------------------------------------------------
# OWNER — con người duy nhất điều khiển relay
# ------------------------------------------------------------

# UUID user owner (Supabase → Authentication → Users).
# Server từ chối mọi JWT không phải user này (allowlist).
RELAY_OWNER_ID=

# ------------------------------------------------------------
# CON DẤU SERVER (secret duy nhất của relay trên Supabase)
# ------------------------------------------------------------

# Chìa khóa HMAC-SHA256: server dùng nó KÝ mỗi bản tin lúc submit_message
# và KIỂM lại chữ ký lúc claim_message (chống sửa tay params trong DB).
# Muse KHÔNG BAO GIỜ thấy giá trị này. Rotate = các tin pending cũ claim sẽ
# fail invalid_signature (an toàn — coi như thu hồi hàng chờ).
# Sinh: openssl rand -hex 32
RELAY_SIGNING_SECRET=

# ------------------------------------------------------------
# NYX / SUITE — credential Muse (KHÔNG còn là secret phía server)
# ------------------------------------------------------------

# Token nằm trong Secure Vault của Nyx. Server KHÔNG giữ giá trị này:
# nó chỉ đối chiếu sha256(token) với cột token_hash trong bảng relay_muses.
# Dùng để:
#   1. Dán vào vault của Muse khi onboard (qua kênh an toàn, không qua chat).
#   2. Suite (scripts/acceptance-tests.sh) giả lập Nyx claim khi test.
# Kiểm tra khớp registry (chạy local, token không đi đâu cả):
#   python -c "import hashlib; print(hashlib.sha256(input().encode()).hexdigest())"
#   → so với: select token_hash from relay_muses where name='Nyx';
# Thu hồi/rotate một Muse BẤT KỲ (kể cả Nyx): xoá hàng registry rồi tạo lại
# qua wizard dashboard (token mới chỉ hiện một lần).
# Sinh: openssl rand -hex 32
RELAY_TOKEN=

# Recipient UUID của Nyx trong relay_muses — suite dùng để GỬI tin vào
# hàng của Nyx khi test (claim thì dùng RELAY_TOKEN ở trên).
# Token và recipient luôn đi đôi: token = "mày là ai", recipient = "hàng của mày".
RELAY_RECIPIENT_ID=
